{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "forge-doctor-api",
  "version": "0.3.3",
  "cli": "forge-doctor-api",
  "cli_entry": "forge_doctor_api.cli:main",
  "workflows": [
    {
      "id": "scan",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "scan",
        "{target}"
      ],
      "description": "Independent API diagnostic",
      "read_only": true
    },
    {
      "id": "diagnose",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "diagnose",
        "{target}"
      ],
      "description": "Contract/reliability diagnosis",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "api-diagnostic-investigator",
    "api-contract-reviewer",
    "api-handoff-governor"
  ],
  "agent_roster_paths": [
    "src/forge_doctor_api/installation/assets/agents"
  ],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true,
  "resources": [
    {
      "id": "README",
      "kind": "agent",
      "location": ".claude/agents/README.md",
      "resource_class": "agentic"
    },
    {
      "id": "src/forge_doctor_api/knowledge/asyncapi/versions.yaml",
      "kind": "knowledge",
      "location": "src/forge_doctor_api/knowledge/asyncapi/versions.yaml",
      "format": "yaml",
      "resource_class": "read-only",
      "packaged_location": "knowledge/asyncapi/versions.yaml"
    },
    {
      "id": "src/forge_doctor_api/knowledge/frameworks/express.yaml",
      "kind": "knowledge",
      "location": "src/forge_doctor_api/knowledge/frameworks/express.yaml",
      "format": "yaml",
      "resource_class": "read-only",
      "packaged_location": "knowledge/frameworks/express.yaml"
    },
    {

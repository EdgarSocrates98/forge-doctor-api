{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "forge-doctor-api",
  "version": "0.3.3",
  "cli": "forge-doctor-api",
  "cli_entry": "forge_doctor_api.cli:main",
  "workflows": [
    {
      "id": "scan",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "scan",
        "{target}"
      ],
      "description": "Independent API diagnostic",
      "read_only": true
    },
    {
      "id": "diagnose",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "diagnose",
        "{target}"
      ],
      "description": "Contract/reliability diagnosis",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "api-diagnostic-investigator",
    "api-contract-reviewer",
    "api-handoff-governor"
  ],
  "agent_roster_paths": [
    "src/forge_doctor_api/installation/assets/agents"
  ],
  "coordinators": [],
  "mcp_command": [
    "{cli}",
    "mcp"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true,
  "resources": [
    {
      "id": "README",
      "kind": "agent",
      "location": ".claude/agents/README.md",
      "resource_class": "agentic"
    },
    {
      "id": "tests/fixtures/contracts",
      "kind": "fixture",
      "location": "tests/fixtures/contracts",
      "resource_class": "test-only"
    },
    {
      "id": "tests/fixtures/openapi",
      "kind": "fixture",
      "location": "tests/fixtures/openapi",
      "resource_class": "test-only"
    },
    {
      "id": "tests/fixtures/oss",
      "kind": "fixture",
      "location": "tests/fixtures/oss",
      "resource_class": "test-only"
    },
    {
      "id": "tests/fixtures/oss-negative",
      "kind": "fixture",
      "location": "tests/fixtures/oss-negative",
      "resource_class": "test-only"
    },
    {
      "id": "tests/fixtures/plugin_src",
      "kind": "fixture",
      "location": "tests/fixtures/plugin_src",
      "resource_class": "test-only"
    }
  ]
}
